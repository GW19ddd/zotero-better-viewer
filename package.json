{
  "name": "zotero-better-viewer",
  "type": "module",
  "version": "3.0.5",
  "packageManager": "pnpm@10.20.0",
  "description": "A Zotero plugin for a better item viewing experience",
  "config": {
    "addonName": "Better Viewer",
    "addonID": "better-viewer@GW19ddd",
    "addonRef": "better-viewer",
    "addonInstance": "BetterViewer",
    "prefsPrefix": "extensions.betterviewer"
  },
  "author": "GW19ddd",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://github.com/GW19ddd/zotero-better-viewer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GW19ddd/zotero-better-viewer.git"
  },
  "bugs": {
    "url": "https://github.com/GW19ddd/zotero-better-viewer/issues"
  },
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "zotero-plugin build && tsc --noEmit",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "release": "zotero-plugin release",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
    "zotero-plugin-toolkit": "^5.0.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.20.1",
    "prettier": "^3.5.1",
    "typescript": "^5.7.3",
    "zotero-plugin-scaffold": "^0.8.0",
    "zotero-types": "^4.0.0"
  }
}

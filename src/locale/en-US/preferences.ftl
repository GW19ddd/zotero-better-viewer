pref-title = Better Viewer Preferences
pref-wrap-rows-title = Rows to wrap
pref-wrap-rows-hint = Choose which kinds of rows wrap. Library header rows and spacers never wrap.
pref-wrap-rows-regular = Regular items
pref-wrap-rows-note = Notes
pref-wrap-rows-attachment = Attachments (incl. PDF)
pref-wrap-rows-annotation = Annotations
pref-wrap-columns-title = Columns to wrap
pref-wrap-columns-hint = Choose which columns wrap. The list is taken from the columns currently visible in the item tree — reopen this pane after changing them.
pref-wrap-columns-unavailable = Column list unavailable — select a library in the items list first.
pref-auto-fit-title = Auto fit
pref-auto-fit-width-on-load = Fit column widths to content when a window opens
pref-auto-fit-font-on-load = Shrink fonts to fit content when a window opens
pref-auto-fit-hint = Both actions are also available from the Auto Fit sub menu of the item context menu. Column widths are only ever grown, and font sizes are measured from the default size, so running them repeatedly is safe. Font size overrides are stored per column and can be reset from the context menu.
pref-help = { $name } Build { $version } { $time }
